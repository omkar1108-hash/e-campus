rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Signed in, has a profile and has not been disabled. Profiles created
    // before the "active" field existed count as active.
    function active() { return signedIn() && profile().get('active', true) == true; }
    function role() { return profile().role; }
    function isAdmin() { return active() && role() == 'admin'; }
    function isAdminStaff() { return active() && role() == 'adminStaff'; }
    function isTeacher() { return active() && role() in ['teacher', 'hod']; }
    function isHod() { return active() && role() == 'hod'; }
    function notDriver() { return active() && role() != 'busDriver'; }
    function canPostNews() {
      return active() && role() in ['classRep', 'teacher', 'hod', 'adminStaff', 'admin'];
    }
    function canManageBooks() {
      return active() && role() in ['teacher', 'hod', 'libraryStaff', 'adminStaff', 'admin'];
    }

    // ---- Users ---------------------------------------------------------
    // Nobody signs themselves up: only admin / admin staff create profiles
    // (the app creates the login and the profile together).
    match /users/{uid} {
      allow read: if active();

      allow create: if request.resource.data.keys().hasOnly(
                         ['email', 'name', 'department', 'role', 'gender', 'active'])
                    && request.resource.data.keys().hasAll(
                         ['email', 'name', 'department', 'role', 'active'])
                    && request.resource.data.active == true
                    && (
                      (isAdmin() && request.resource.data.role in
                        ['admin', 'adminStaff', 'grievanceCommittee', 'libraryStaff',
                         'hod', 'teacher', 'student', 'busDriver'])
                      ||
                      (isAdminStaff() && request.resource.data.role in
                        ['grievanceCommittee', 'libraryStaff', 'teacher',
                         'student', 'busDriver'])
                    );

      allow update: if
        // Admin: anyone but themselves.
        (isAdmin() && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'department', 'role', 'gender', 'active']))
        ||
        // Admin staff: never administrators, never themselves, and they
        // cannot grant administrator or admin-staff roles.
        (isAdminStaff() && uid != request.auth.uid
          && resource.data.role != 'admin'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'department', 'role', 'gender', 'active'])
          && (request.resource.data.role == resource.data.role
              // Only the administrator appoints or removes a head of department.
              || (resource.data.role != 'hod'
                  && request.resource.data.role in
                       ['student', 'classRep', 'teacher', 'grievanceCommittee',
                        'libraryStaff', 'busDriver'])))
        ||
        // Head of department: only toggle student <-> class rep inside their
        // own department. (The 2 girls + 2 boys limit is enforced by the app.)
        (isHod() && resource.data.department == profile().department
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && ((resource.data.role == 'student' && request.resource.data.role == 'classRep')
              || (resource.data.role == 'classRep' && request.resource.data.role == 'student')));

      // Accounts are disabled, never deleted.
      allow delete: if false;
    }

    // ---- E-library -----------------------------------------------------
    // Teachers' books start as "pending" and are approved or rejected by
    // library staff. Everybody except drivers reads approved books; a teacher
    // also sees their own; library staff, admin staff and admin see all.
    function bookStaff() {
      return active() && role() in ['libraryStaff', 'adminStaff', 'admin'];
    }
    function validBook(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.author is string && d.author.size() <= 200
          && d.category is string && d.category.size() <= 100
          && d.url is string && d.url.size() <= 2000
          && d.get('isbn', '') is string && d.get('isbn', '').size() <= 20
          && (!('cover' in d) || (d.cover is string && d.cover.size() <= 700000));
    }
    function bookChanges() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /books/{id} {
      allow read: if notDriver()
                  && (role() in ['libraryStaff', 'adminStaff', 'admin']
                      || resource.data.get('status', '') == 'approved'
                      || resource.data.get('uploadedBy', '') == request.auth.uid);

      allow create: if canManageBooks()
                    && request.resource.data.keys().hasOnly(
                         ['title', 'author', 'category', 'url', 'isbn', 'cover',
                          'status', 'uploadedBy', 'uploadedByName', 'rejectReason',
                          'createdAt'])
                    && validBook(request.resource.data)
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.get('rejectReason', '') == ''
                    && ((role() in ['teacher', 'hod']
                         && request.resource.data.status == 'pending')
                        || (role() in ['libraryStaff', 'adminStaff', 'admin']
                            && request.resource.data.status == 'approved'));

      allow update: if active() && (
        // Library staff verify a pending book.
        (role() == 'libraryStaff'
         && resource.data.get('status', '') == 'pending'
         && bookChanges().hasOnly(['status', 'rejectReason'])
         && ((request.resource.data.status == 'approved'
              && request.resource.data.get('rejectReason', '') == '')
             || (request.resource.data.status == 'rejected'
                 && request.resource.data.rejectReason is string
                 && request.resource.data.rejectReason.size() > 0
                 && request.resource.data.rejectReason.size() <= 200)))
        ||
        // Library staff, admin staff and admin edit any book's content.
        (bookStaff()
         && bookChanges().hasOnly(['title', 'author', 'category', 'url', 'isbn', 'cover'])
         && validBook(request.resource.data))
        ||
        // A teacher fixes their own unapproved book; it goes back for review.
        (role() in ['teacher', 'hod']
         && resource.data.get('uploadedBy', '') == request.auth.uid
         && resource.data.get('status', '') in ['pending', 'rejected']
         && bookChanges().hasOnly(['title', 'author', 'category', 'url', 'isbn',
                                   'cover', 'status', 'rejectReason'])
         && request.resource.data.status == 'pending'
         && request.resource.data.get('rejectReason', '') == ''
         && validBook(request.resource.data))
        ||
        // One-off: books added before approvals existed become approved.
        (bookStaff() && !('status' in resource.data)
         && bookChanges().hasOnly(['status', 'uploadedBy'])
         && request.resource.data.status == 'approved'));

      // The uploader, library staff, admin staff and admin may delete.
      allow delete: if active()
                    && (bookStaff()
                        || resource.data.get('uploadedBy', '') == request.auth.uid);
    }

    // ---- Tech news -----------------------------------------------------
    match /news/{id} {
      allow read: if notDriver();
      allow create: if canPostNews()
                    && (isAdmin() || request.resource.data.department == profile().department)
                    && request.resource.data.keys().hasOnly(
                         ['title', 'body', 'department', 'authorName', 'createdAt', 'image'])
                    && (!('image' in request.resource.data)
                        || (request.resource.data.image is string
                            && request.resource.data.image.size() <= 700000));
      allow delete: if isAdmin() || isAdminStaff()
                    || (canPostNews() && resource.data.department == profile().department);
    }

    // ---- Notices -------------------------------------------------------
    // College-wide. Admin and admin staff post and delete. A notice marked
    // public is also readable before sign-in (the opening page).
    // Each notice lists who it is for in `targets` ("branch|group" pairs,
    // "all" meaning every branch / everybody); a person reads it when one of
    // their four target values appears there.
    function myGroup() {
      return role() in ['student', 'classRep'] ? 'student'
           : role() in ['teacher', 'hod'] ? 'teacher'
           : role() == 'busDriver' ? 'driver' : 'staff';
    }
    function myTargets() {
      return ['all|all', 'all|' + myGroup(),
              profile().department + '|all',
              profile().department + '|' + myGroup()];
    }
    function validTargets(d) {
      return d.targets is list && d.targets.size() > 0 && d.targets.size() <= 40
          && d.departments is list && d.audience is list;
    }

    match /notices/{id} {
      allow read: if resource.data.get('public', false) == true
                  || (active() && (role() in ['admin', 'adminStaff']
                      || resource.data.get('targets', []).hasAny(myTargets())));
      allow create: if (isAdmin() || isAdminStaff())
                    && request.resource.data.keys().hasOnly(
                         ['title', 'body', 'authorName', 'createdAt', 'image', 'public',
                          'departments', 'audience', 'targets'])
                    && validTargets(request.resource.data)
                    && (request.resource.data.public == false
                        || request.resource.data.targets == ['all|all'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.body is string
                    && request.resource.data.body.size() <= 4000
                    && request.resource.data.public is bool
                    && (!('image' in request.resource.data)
                        || (request.resource.data.image is string
                            && request.resource.data.image.size() <= 700000));
      allow update: if false;
      allow delete: if isAdmin() || isAdminStaff();
    }

    // ---- Emergency alerts ------------------------------------------------
    // Only the administrator sends or clears an alert. It reaches the branches
    // and groups chosen (drivers included); the same `targets` idea as notices.
    match /alerts/{id} {
      allow read: if active()
                  && (role() == 'admin'
                      || resource.data.targets.hasAny(myTargets()));
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(
                         ['message', 'authorName', 'createdAt', 'active',
                          'departments', 'audience', 'targets'])
                    && validTargets(request.resource.data)
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 300
                    && request.resource.data.active == true;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['active', 'clearedAt'])
                    && request.resource.data.active == false;
      allow delete: if false;
    }

    // ---- Timetable -----------------------------------------------------
    // One document per department. Its students and teachers read it; admin
    // and admin staff read every one; only that department's head of
    // department writes it (the admin appoints the head).
    match /timetables/{department} {
      allow read: if active()
                  && (role() in ['admin', 'adminStaff']
                      || (role() in ['student', 'classRep', 'teacher', 'hod']
                          && profile().department == department));
      allow create, update: if isHod() && profile().department == department
                    && request.resource.data.keys().hasOnly(['slots', 'updatedAt'])
                    && request.resource.data.slots is list
                    && request.resource.data.slots.size() <= 200;
      allow delete: if false;
    }

    // ---- Assignments & notes ---------------------------------------------
    // Teachers post links; students read their own department's items.
    match /assignments/{id} {
      allow read: if active() && role() in ['teacher', 'hod', 'student', 'classRep']
                  && (resource.data.get('createdBy', '') == request.auth.uid
                      || resource.data.get('department', '') == profile().department);
      allow create: if isTeacher()
                    && request.resource.data.keys().hasOnly(
                         ['kind', 'department', 'subject', 'title', 'description',
                          'link', 'dueDate', 'createdBy', 'createdByName', 'createdAt'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.kind in ['assignment', 'note']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 2000
                    && request.resource.data.link is string
                    && request.resource.data.link.size() <= 2000
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 100;
      allow update: if false;
      allow delete: if isTeacher() && resource.data.get('createdBy', '') == request.auth.uid;
    }

    // ---- Attendance ----------------------------------------------------
    // One record per student, subject and day. Teachers write them; a
    // student reads only their own. (The rules cannot check that the student
    // belongs to the teacher's class - see the README.)
    match /attendanceRecords/{id} {
      allow read: if active()
                  && (resource.data.studentUid == request.auth.uid
                      || resource.data.teacherUid == request.auth.uid
                      || role() in ['admin', 'adminStaff']);
      allow create: if isTeacher()
                    && request.resource.data.keys().hasOnly(
                         ['studentUid', 'studentName', 'department', 'subject',
                          'date', 'present', 'teacherUid'])
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.present is bool
                    && request.resource.data.date is string
                    && request.resource.data.date.size() == 10
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() > 0
                    && request.resource.data.subject.size() <= 100;
      // Correcting a mistake: only the teacher who marked it, only "present".
      allow update: if isTeacher() && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['present'])
                    && request.resource.data.present is bool;
      allow delete: if false;
    }

    // ---- Complaints ----------------------------------------------------
    // A complaint is stored twice. `complaints` is what the committee sees
    // (an anonymous one carries no name). `complaintIdentities` says who
    // filed it and is readable only by that person and the administrator.
    // Rules cannot hide single fields, hence two collections.
    function isCommittee() { return active() && role() == 'grievanceCommittee'; }
    function identityOf(id) {
      return get(/databases/$(database)/documents/complaintIdentities/$(id)).data;
    }
    function isFiler(id) { return identityOf(id).filedBy == request.auth.uid; }
    function canReadAllComplaints() {
      return active() && role() in ['grievanceCommittee', 'adminStaff', 'admin'];
    }
    // Sent -> Working on it -> Resolved (committee) -> Closed (the person who
    // filed it confirms) or back to Working on it (they say it is not fixed).
    function committeeMove() {
      let from = resource.data.get('status', 'submitted');
      let to = request.resource.data.status;
      return (from == 'submitted' && to in ['inReview', 'resolved', 'rejected'])
          || (from == 'inReview' && to in ['resolved', 'rejected']);
    }
    function filerMove() {
      return resource.data.get('status', 'submitted') == 'resolved'
          && request.resource.data.status in ['closed', 'inReview'];
    }
    function statusOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt is number;
    }

    match /complaintIdentities/{id} {
      allow read: if active()
                  && (resource.data.filedBy == request.auth.uid || isAdmin());
      allow create: if active() && !isCommittee()
                    && request.resource.data.keys().hasOnly(
                         ['filedBy', 'filedByName', 'filedByDepartment', 'anonymous',
                          'category', 'subject', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.filedBy == request.auth.uid
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.anonymous is bool
                    && existsAfter(/databases/$(database)/documents/complaints/$(id));
      // Only the status mirror changes: the committee moves it forward, the
      // person who filed it confirms or reopens a resolved complaint.
      allow update: if active() && statusOnly()
                    && ((isCommittee() && committeeMove())
                        || (resource.data.filedBy == request.auth.uid && filerMove()));
      allow delete: if false;
    }

    match /complaints/{id} {
      allow read: if active()
                  && (canReadAllComplaints() || isFiler(id));
      allow create: if active() && !isCommittee()
                    && request.resource.data.keys().hasOnly(
                         ['category', 'subject', 'description', 'anonymous',
                          'displayName', 'displayDepartment', 'status',
                          'createdAt', 'updatedAt'])
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() > 0
                    && request.resource.data.subject.size() <= 120
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 4000
                    && request.resource.data.anonymous is bool
                    && getAfter(/databases/$(database)/documents/complaintIdentities/$(id))
                         .data.filedBy == request.auth.uid
                    && getAfter(/databases/$(database)/documents/complaintIdentities/$(id))
                         .data.anonymous == request.resource.data.anonymous
                    && (request.resource.data.anonymous
                        ? (request.resource.data.displayName == 'Anonymous'
                           && request.resource.data.displayDepartment == '')
                        : (request.resource.data.displayName == profile().name
                           && request.resource.data.displayDepartment
                                == profile().department));
      allow update: if active() && statusOnly()
                    && ((isCommittee() && committeeMove())
                        || (isFiler(id) && filerMove()));
      allow delete: if false;

      match /replies/{rid} {
        allow read: if active() && (canReadAllComplaints() || isFiler(id));
        allow create: if active()
                      && request.resource.data.keys().hasOnly(
                           ['kind', 'byCommittee', 'authorName', 'text', 'createdAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.authorName is string
                      && request.resource.data.authorName.size() <= 100
                      && (
                        (isCommittee() && request.resource.data.byCommittee == true
                         && request.resource.data.kind in ['reply', 'status'])
                        ||
                        (!isCommittee() && isFiler(id)
                         && request.resource.data.byCommittee == false
                         && request.resource.data.kind in ['reply', 'status']
                         && get(/databases/$(database)/documents/complaints/$(id))
                              .data.status in ['submitted', 'inReview', 'resolved'])
                      );
        allow update, delete: if false;
      }
    }

    // ---- Activity log --------------------------------------------------
    // Written by the app on the actor's behalf (so it is a convenience
    // record, not tamper-proof) and readable by the administrator only.
    match /activityLog/{id} {
      allow read: if isAdmin();
      allow create: if active()
                    && request.resource.data.keys().hasOnly(
                         ['action', 'actorUid', 'actorName', 'actorRole',
                          'targetType', 'targetLabel', 'details', 'createdAt'])
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.actorRole == role()
                    && request.resource.data.action is string
                    && request.resource.data.action.size() <= 40
                    && request.resource.data.targetLabel is string
                    && request.resource.data.targetLabel.size() <= 200
                    && request.resource.data.details is string
                    && request.resource.data.details.size() <= 200;
      allow update, delete: if false;
    }

    // ---- Chat ----------------------------------------------------------
    // Conversation id is "<uidA>_<uidB>" (sorted); only those two may use it.
    function chatParts(chatId) { return chatId.split('_'); }
    function inChat(chatId) {
      return chatParts(chatId).size() == 2
          && chatParts(chatId)[0] != chatParts(chatId)[1]
          && request.auth.uid in chatParts(chatId);
    }
    function otherInChat(chatId) {
      return chatParts(chatId)[0] == request.auth.uid
          ? chatParts(chatId)[1] : chatParts(chatId)[0];
    }
    function isStudentRole(r) { return r in ['student', 'classRep']; }

    // Students talk to all students and to teachers of their own department.
    // Teachers talk to students of their department and to all staff.
    // Staff talk to each other. Students cannot chat with other staff.
    function mayChat(chatId) {
      let other = get(/databases/$(database)/documents/users/$(otherInChat(chatId))).data;
      let me = profile();
      return other.get('active', true) == true && (
        (isStudentRole(me.role) && isStudentRole(other.role))
        || (isStudentRole(me.role) && other.role in ['teacher', 'hod']
            && other.department == me.department)
        || (me.role in ['teacher', 'hod'] && isStudentRole(other.role)
            && other.department == me.department)
        || (!isStudentRole(me.role) && !isStudentRole(other.role)));
    }

    function validText(t) { return t is string && t.size() > 0 && t.size() <= 4000; }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if active() && inChat(chatId);

      allow create: if active() && inChat(chatId) && mayChat(chatId)
                    && request.resource.data.keys().hasOnly(
                         ['senderId', 'text', 'sentAt', 'deleted', 'pinned'])
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.deleted == false
                    && request.resource.data.pinned == false
                    && validText(request.resource.data.text);

      allow update: if active() && inChat(chatId)
                    && resource.data.get('deleted', false) == false
                    && (
        // Either person pins or unpins.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
         && request.resource.data.pinned is bool)
        ||
        // The sender edits their own message.
        (resource.data.senderId == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'editedAt'])
         && validText(request.resource.data.text))
        ||
        // The sender deletes their own message (it stays as a stub).
        (resource.data.senderId == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'text', 'pinned'])
         && request.resource.data.deleted == true
         && request.resource.data.text == ''));

      allow delete: if false;
    }

    // Latest message of a conversation: drives the chat list, unread dots
    // and the "new message" banner.
    function validSummary(chatId) {
      return request.resource.data.keys().hasOnly(
               ['participants', 'lastText', 'lastMessageAt', 'lastSenderId'])
          && request.resource.data.participants == chatParts(chatId)
          && request.resource.data.lastSenderId == request.auth.uid
          && request.resource.data.lastText is string
          && request.resource.data.lastText.size() <= 4000;
    }

    match /chats/{chatId} {
      allow read: if active() && request.auth.uid in resource.data.participants;
      allow create: if active() && inChat(chatId) && mayChat(chatId)
                    && validSummary(chatId);
      // Editing or deleting the newest message only changes its preview.
      allow update: if active() && inChat(chatId) && validSummary(chatId)
                    && (mayChat(chatId)
                        || request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['lastText']));
      allow delete: if false;
    }

    // When each person last opened each chat. Private to that person.
    match /userState/{uid} {
      allow read: if active() && request.auth.uid == uid;
      allow create, update: if active() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['readAt'])
                            && request.resource.data.readAt is map;
    }

    // ---- Buses ---------------------------------------------------------
    // Configuration (name, plate, driver, departments) is written by admin /
    // admin staff; live trip fields only by the assigned driver.
    function canTrackAnyBus() {
      return active() && role() in ['admin', 'adminStaff', 'teacher', 'hod', 'libraryStaff',
                                  'grievanceCommittee'];
    }

    // The route is a start and an end point (name + coordinates), both set or
    // both null. The bus switches between 'outbound' and 'return' on arrival.
    function coord(v, limit) {
      return v == null || (v is number && v >= -limit && v <= limit);
    }
    function validRoute(d) {
      return coord(d.get('startLat', null), 90) && coord(d.get('endLat', null), 90)
          && coord(d.get('startLng', null), 180) && coord(d.get('endLng', null), 180)
          && (d.get('startLat', null) == null) == (d.get('endLat', null) == null)
          && (d.get('startLat', null) == null) == (d.get('startLng', null) == null)
          && (d.get('endLat', null) == null) == (d.get('endLng', null) == null);
    }

    match /buses/{id} {
      allow read: if canTrackAnyBus()
                  || (active() && role() in ['student', 'classRep']
                      && profile().department in resource.data.departments)
                  || (active() && role() == 'busDriver'
                      && resource.data.driverUid == request.auth.uid);

      allow create: if (isAdmin() || isAdminStaff())
                    && request.resource.data.keys().hasOnly(
                         ['name', 'plate', 'driverUid', 'departments', 'active',
                          'startName', 'startLat', 'startLng',
                          'endName', 'endLat', 'endLng'])
                    && validRoute(request.resource.data)
                    && request.resource.data.active == false
                    && request.resource.data.name is string
                    && request.resource.data.departments is list;

      allow update:
        // Administration edits the configuration only.
        if ((isAdmin() || isAdminStaff())
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['name', 'plate', 'driverUid', 'departments',
                            'startName', 'startLat', 'startLng',
                            'endName', 'endLat', 'endLng'])
             && validRoute(request.resource.data))
        // The assigned driver controls the trip only.
        || (active() && role() == 'busDriver'
             && resource.data.driverUid == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['active', 'lat', 'lng', 'updatedAt', 'tripStartedAt', 'leg'])
             && request.resource.data.get('leg', 'outbound') in ['outbound', 'return']);

      allow delete: if isAdmin() || isAdminStaff();
    }
  }
}
